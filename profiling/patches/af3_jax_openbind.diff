+  # OPENBIND PATCH. The two OpenFold3 releases differ in two places the model reads from
+  # global_config: the ending-node pair bias axes and the diffusion transformer's pair
+  # LayerNorm scope. The fork resolves which by reading the of3_variant marker that
+  # convert_of3_weights.py writes beside the converted parameters; this script is the kit's
+  # own copy and had no such switch, so an openbind checkpoint took the preview-2 branch and
+  # stopped on a missing 'pair_input_layer_norm' parameter. Env override: AF3_JAX_OF3_OPENBIND.
+  def _resolve_of3_openbind(model_dir) -> bool:
+    forced = os.environ.get("AF3_JAX_OF3_OPENBIND", "auto").strip().lower()
+    if forced in ("true", "1", "yes"):
+      return True
+    if forced in ("false", "0", "no"):
+      return False
+    try:
+      marker = (pathlib.Path(str(model_dir)) / "of3_variant").read_text().strip()
+    except OSError:
+      print("Warning: no of3_variant marker beside the weights; assuming preview-2.")
+      return False
+    print(f"OF3 weights: variant={marker}")
+    return marker == "openbind"
